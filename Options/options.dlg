
local position = 103
local first_column_x = 57
local first_column_control_width = 261
local second_column_control_width = 275
local second_column_x = 403
local control_height = 18
local control_extended_height = 25
local control_vertical_spacing = 21



function next_y(delta)
	delta = delta or control_height
	delta = delta + control_vertical_spacing
	local result = position
	position = position + delta
	return result
end

function reset_y()
	position = 103
	return next_y()
end

function next_section()
end

